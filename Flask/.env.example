# 安全密钥（生产环境必须改成强随机值，且不要提交到版本库）
# 生成方式: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-to-a-random-secret
JWT_SECRET_KEY=please-change-this-to-another-random-secret
FLASK_ENV=development
DATABASE_URL=sqlite:///chatbot.db

# 邮箱（QQ SMTP），填你自己的新授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq-account@qq.com
SMTP_PASS=your-smtp-authorization-code
SENDER_NAME=AI 聊天助手

# 免费 API（默认开启但没配会聊不了天）
FREE_API_ENABLED=true
FREE_API_URL=https://open.bigmodel.cn/api/paas/v4
FREE_API_KEY=your-free-api-key
FREE_API_MODEL=glm-4.7-flash
FREE_API_NAME=免费 GLM-4.7-flash

# SSRF 防护（拦截外发请求指向内网/云元数据，建议保持 true）
SSRF_PROTECTION=true

# 是否部署在受信反向代理(Nginx/网关)之后：仅这样才能信任 X-Forwarded-For。
# 直连公网或被 DDoS 防护直接转发时保持 false，否则易被伪造头绕过登录限流。
TRUST_PROXY_HEADERS=false