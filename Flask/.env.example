# ─────────────────────────────────────────────────────────────
# Confide 环境变量模板
# 使用：复制为 Flask/.env 后填入真实值；.env 已被 .gitignore 排除，
#       切勿把含真实密钥的 .env 提交到版本库或上传到服务器（用环境变量注入）。
# 生成强随机密钥: python -c "import secrets;print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────

# 安全密钥（生产必须为强随机值，否则后端拒绝启动）
SECRET_KEY=please-change-this-to-a-random-secret
JWT_SECRET_KEY=please-change-this-to-another-random-secret
FLASK_ENV=development
# 本地默认使用 Flask/instance/chatbot.db；生产可换成 MySQL 8：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/confide?charset=utf8mb4
DATABASE_URL=

# 时间统一时区（写库存 naive 时间，API 输出带偏移）
APP_TIMEZONE=Asia/Shanghai

# Access Token 有效期（秒），默认 2 小时；过期后前端用 refresh token 静默续期
JWT_ACCESS_TOKEN_EXPIRES=7200

# 邮箱（QQ SMTP），填你自己的新授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq-account@qq.com
SMTP_PASS=your-smtp-authorization-code
SENDER_NAME=心语

# 免费 API（默认开启但没配会聊不了天）
FREE_API_ENABLED=true
FREE_API_URL=https://open.bigmodel.cn/api/paas/v4
FREE_API_KEY=your-free-api-key
FREE_API_MODEL=glm-4.7-flash
FREE_API_NAME=免费 GLM-4.7-flash

# 免费生图（共享 Key，用户未配置图片生成时回退使用）
IMAGE_FREE_API_URL=https://apihub.agnes-ai.cn/v1
IMAGE_FREE_API_KEY=your-image-free-api-key
IMAGE_FREE_MODEL=agnes-image-2.1-flash
IMAGE_FREE_LIMIT=5

# 管理员账号（独立后台，登录入口 /admin）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# SSRF 防护（拦截外发请求指向内网/云元数据，建议保持 true）
SSRF_PROTECTION=true

# 是否部署在受信反向代理(Nginx/网关)之后：仅这样才能信任 X-Forwarded-For。
# 直连公网或被 DDoS 防护直接转发时保持 false，否则易被伪造头绕过登录限流。
TRUST_PROXY_HEADERS=false

# CORS 允许来源（逗号分隔），生产请改为你的真实域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
